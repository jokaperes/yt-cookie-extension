{
  "manifest_version": 3,
  "name": "YouTube Cookie Exporter",
  "version": "1.0",
  "description": "Export YouTube cookies in Netscape format for yt-dlp",
  "permissions": ["cookies", "downloads", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}